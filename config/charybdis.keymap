#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Hyper = Ctrl + Shift + Alt + GUI
#define HYPER(key) LC(LS(LA(LG(key))))

&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";
        
        // Скобки — одновременное нажатие соседних клавиш
        combo_lbrace {
            timeout-ms = <50>;
            key-positions = <16 17>;  // Q + W
            bindings = <&kp LBKT>;    // [
        };
        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <17 18>;  // W + E
            bindings = <&kp RBKT>;    // ]
        };
        combo_lparen {
            timeout-ms = <50>;
            key-positions = <18 19>;  // E + R
            bindings = <&kp LPAR>;    // (
        };
        combo_rparen {
            timeout-ms = <50>;
            key-positions = <19 20>;  // R + T
            bindings = <&kp RPAR>;    // )
        };
        combo_lcurly {
            timeout-ms = <50>;
            key-positions = <28 29>;  // A + S
            bindings = <&kp LBRC>;    // {
        };
        combo_rcurly {
            timeout-ms = <50>;
            key-positions = <29 30>;  // S + D
            bindings = <&kp RBRC>;    // }
        };
        
        // Переключение языка — J + K одновременно
        combo_lang_switch {
            timeout-ms = <50>;
            key-positions = <31 32>;  // J + K
            bindings = <&kp LG(SPACE)>;  // Cmd+Space (macOS) или замени на &kp CAPS для Windows
        };
    };
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1  &kp N2   &kp N3            &kp N4        &kp N5          &kp N6      &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W    &kp E             &kp R         &kp T           &kp Y       &kp U      &kp I      &kp O    &kp P     &kp BSLH
&mt LCTRL ESC    &mt LCTRL A  &mt LALT S  &mt LSHFT D  &mt LGUI F  &kp G    &kp H  &mt RGUI J  &mt RSHFT K  &mt LALT L  &mt RCTRL SEMI  &kp SQT
&kp LEFT_SHIFT  &lt 4 Z   &lt 3 X    &lt 5 C    &lt 6 V    &lt 2 B    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                 &kp LEFT_CONTROL  &kp SPACE     &mo 1           &kp DELETE  &kp SPACE
                                                   &kp LEFT_WIN  &kp LEFT_ALT    &kp ENTER
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7     &kp F8     &kp F9    &kp F10       &kp F11    &kp F12
&trans  &none   &none   &none   &none   &trans        &none      &none      &none     &kp UP_ARROW  &kp MINUS  &kp EQUAL
&trans  &none   &none   &none   &none   &trans        &mkp LCLK  &mkp RCLK  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &none         &none      &none      &trans    &trans        &none      &trans
                        &trans  &trans  &To0_macro    &mkp LCLK  &mkp RCLK
                                &trans  &trans        &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        symbols_layer {
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
&trans     &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR   &kp PIPE     &kp MINUS  &kp EQUAL &kp UNDER  &kp PLUS  &kp BSLH  &kp GRAVE
&trans     &kp LBRC  &kp RBRC  &kp LT    &kp GT     &kp TILDE    &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT &kp COLON &kp DQT
&trans     &trans    &trans    &trans    &trans     &trans       &trans     &trans    &kp LT     &kp GT    &kp QMARK &trans
                               &trans    &trans     &trans       &trans     &trans
                                         &trans     &trans       &trans
            >;
        };
        hyper_layer {
            bindings = <
&trans          &kp HYPER(N1)  &kp HYPER(N2)  &kp HYPER(N3)  &kp HYPER(N4)  &kp HYPER(N5)    &kp HYPER(N6)  &kp HYPER(N7)  &kp HYPER(N8)  &kp HYPER(N9)  &kp HYPER(N0)  &trans
&trans          &kp HYPER(Q)   &kp HYPER(W)   &kp HYPER(E)   &kp HYPER(R)   &kp HYPER(T)     &kp HYPER(Y)   &kp HYPER(U)   &kp HYPER(I)   &kp HYPER(O)   &kp HYPER(P)   &trans
&trans          &kp HYPER(A)   &kp HYPER(S)   &kp HYPER(D)   &kp HYPER(F)   &kp HYPER(G)     &kp HYPER(H)   &kp HYPER(J)   &kp HYPER(K)   &kp HYPER(L)   &trans         &trans
&trans          &kp HYPER(Z)   &kp HYPER(X)   &kp HYPER(C)   &kp HYPER(V)   &kp HYPER(B)     &kp HYPER(N)   &kp HYPER(M)   &trans         &trans         &trans         &trans
                                              &trans         &trans         &trans           &trans         &trans
                                                             &trans         &trans           &trans
            >;
        };
    };
};
