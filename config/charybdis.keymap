#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <130>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <40>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <130>;
    require-prior-idle-ms = <40>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Скобки — одновременное нажатие соседних клавиш

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <21 22>;  // O + P
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;  // I + O
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <19 20>;  // U + I
            bindings = <&kp MINUS>;    // -
        };

        // Переключение языка — J + K одновременно
        // Переключение языка с Shift — D + F одновременно (Right Command + Shift + Space)
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp N1       &kp N2          &kp N3          &kp N4            &kp N5                 &kp N6     &kp N7               &kp N8           &kp N9          &kp N0               &kp BACKSPACE
&kp TAB         &kp Q        &kp W           &kp E           &kp R             &kp T                  &kp Y      &kp U                &kp I            &kp O           &kp P                &kp LBKT
&lt 6 CAPSLOCK   &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G                  &kp H      &mt RIGHT_SHIFT J    &mt RIGHT_GUI K  &mt LEFT_ALT L  &mt LCTRL SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &mt LCTRL Z  &mt LALT X      &mt LEFT_GUI C  &lt 2 V           &lt 4 B                &kp N      &mt RIGHT_GUI M      &lt 1 COMMA      &lt 2 DOT       &kp FSLH             &kp RIGHT_SHIFT
                                             &lt 1 SPACE     &lt 2 UP_ARROW    &mt RIGHT_ALT RIGHT    &lt 3 DEL  &mt RIGHT_ALT SPACE
                                                             &lt 2 LEFT        &lt 5 DOWN             &kp ENTER
            >;
        };

        snipe-layers {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP   &kp LS(C_AC_HOME)  &kp C_AC_SEARCH   &kp K_MUTE            &kp C_VOL_DN    &kp C_VOL_UP       &kp C_PREV             &kp C_PP           &kp C_NEXT       &kp MINUS         &kp EQUAL
&trans        &kp LESS_THAN  &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp TAB         &kp LG(BACKSPACE)  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp RIGHT_BRACKET
&trans        &trans         &trans             &trans            &trans                &trans          &mkp RCLK          &mkp LCLK              &trans             &trans           &trans            &kp BACKSLASH
&trans        &trans         &trans             &trans            &trans                &trans          &trans             &trans                 &trans             &trans           &trans            &trans
                                                &trans            &trans                &trans          &mkp RCLK          &mkp LCLK
                                                                  &trans                &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans             &trans    &trans         &trans          &trans     &kp MINUS  &kp EQUAL
&trans  &trans  &trans  &trans  &trans          &trans             &kp HOME  &kp PAGE_UP    &msc SCRL_UP    &trans     &trans     &kp RBKT
&trans  &trans  &trans  &trans  &trans          &trans             &kp LEFT  &kp DOWN       &kp UP          &kp RIGHT  &trans     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans          &trans             &kp END   &kp PAGE_DOWN  &msc SCRL_DOWN  &trans     &trans     &trans
                        &trans  &kp UP_ARROW    &kp RIGHT_ARROW    &trans    &trans
                                &kp LEFT_ARROW  &kp DOWN_ARROW     &trans
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7     &kp F8     &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        WINDOWS_LAYERS {
            bindings = <
&trans  &kp LA(LC(NUMBER_1))  &kp LA(LC(NUMBER_2))  &kp LA(LC(NUMBER_3))  &kp LA(LC(NUMBER_4))  &kp LA(LC(N5))    &kp LA(LC(NUMBER_6))  &kp LC(LA(N7))  &kp LC(LA(N8))     &kp LC(LA(N9))   &kp LC(LA(N0))  &trans
&trans  &trans                &trans                &trans                &trans                &trans            &kp LA(LC(Y))         &kp LA(LC(U))   &kp LA(LC(I))      &kp LA(LC(O))    &trans          &trans
&trans  &trans                &trans                &trans                &trans                &trans            &kp LA(LC(H))         &kp LA(LC(J))   &kp LA(LC(K))      &kp LA(LC(L))    &trans          &trans
&trans  &trans                &trans                &trans                &trans                &trans            &kp LA(LC(N))         &kp LA(LC(M))   &kp LA(LC(COMMA))  &kp LA(LC(DOT))  &trans          &trans
                                                    &trans                &trans                &trans            &trans                &trans
                                                                          &trans                &trans            &kp LC(LA(ENTER))
            >;
        };

        // Layer 6: CARET — трекбол двигает текстовый курсор (стрелки) вместо мыши
        // Все клавиши прозрачны, клавиатура работает как обычно
        caret_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
