#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// В этом файле НЕТ #define и других макросов препроцессора — намеренно.
// Keymap editor (nickcoutsos.github.io/keymap-editor) их не разбирает и перестаёт
// показывать раскладку. Поэтому номера слоёв и сочетания записаны буквально:
//
//   слои: 0 BASE, 1 MOUSE, 2 SNIPE, 3 SCROLL, 4 NAV, 5 NUM, 6 FUN
//         (номер = порядок узлов в keymap {}; check_keymap.py сверяет держатели
//          слоёв и номера в overlay'ях по display-name)
//
//   LC(SPACE) на 54 — переключение языка. macOS видит Ctrl+Space (предыдущий
//         источник ввода), Ubuntu из-за обмена Ctrl/Win — Super+Space (смена раскладки).
//
//   LS(LA(LC(LGUI))) на 51 — Hyper = Ctrl+Alt+Shift+Super разом, под запуск
//         приложений (Ubuntu: расширение Run or raise; macOS: BetterTouchTool).
//         Базовый keycode — модификатор (LGUI), поэтому ZMK держит все четыре как
//         явные модификаторы, пока нажата следующая клавиша.
//
//   LG(…) / LC(…) в слоях для Ubuntu. Клавиатура в основном на Ubuntu (обычный KVM),
//         там включён ctrl:swap_lwin_lctl (GNOME Tweaks, dconf
//         /org/gnome/desktop/input-sources/xkb-options): клавиатурный LGUI приходит
//         как Ctrl, LCTRL — как Super. Поэтому LG(x) = Ctrl+x на Ubuntu,
//         LC(x) = Super+x. Cmd на большом пальце (49) там работает как Ctrl.

&mt {
    // &mt используется только на 24: Ctrl на удержании, Esc на тап.
    // balanced: хол, если другая клавиша нажата И отпущена за время удержания —
    // Ctrl+C перекатом срабатывает, а быстрый Esc -> буква остаётся Esc.
    // Если Ctrl+C будет давать "Esc c" — flavor = "hold-preferred" (план, тюнинг).
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;   // тап + повтор в это окно = автоповтор тапа
};

&lt {
    // Только большие пальцы: 50 NAV/Tab, 54 FUN/Lang, 55 NUM/Enter.
    // balanced: хол, если другая клавиша нажата И отпущена за время удержания.
    // require-prior-idle-ms НЕ задавать: иначе слой сразу после буквы дал бы
    // тап (Tab/Enter) вместо слоя (раньше стояло 40 — для layer-tap на буквах).
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;   // тап + повтор в это окно = автоповтор Tab/Enter
};

// Caps Word включается двойным тапом любого Shift (td_shift_l / td_shift_r).
// Буквы и цифры ZMK всегда считает продолжением. continue-list ЗАМЕНЯЕТ
// дефолтный список (UNDERSCORE BSPC DEL), поэтому он перечислен заново,
// плюс MINUS — дефис не сбрасывает Caps Word (MY-CONST). Цифры перечислены
// явно, хотя и так продолжают. Пробел, точка, Enter — выключают.
&caps_word {
    continue-list = <UNDERSCORE MINUS BSPC DEL N1 N2 N3 N4 N5 N6 N7 N8 N9 N0>;
};

/ {
    behaviors {
        // Shift на мизинцах: удержание / вместе с клавишей — Shift,
        // двойной тап — Caps Word. С другой клавишей Shift срабатывает сразу
        // (tap-dance разрешается по прерыванию); одиночный удержанный Shift
        // без других клавиш доходит до ОС через tapping-term (200 мс).
        td_shift_l: td_shift_l {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };

        td_shift_r: td_shift_r {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&caps_word>;
        };

        // 51: тап — Backspace, удержание — Hyper (запуск приложений: Hyper+T и т.п.).
        // Отдельный hold-tap, а не &mt: require-prior-idle-ms = 150 — Backspace,
        // нажатый сразу после буквы, срабатывает мгновенно как Backspace (и при
        // удержании повторяется), так что перекат при наборе не превратится в
        // Hyper+буква и не запустит приложение. Hyper нужен «с паузы» — и так всегда.
        hyper_bspc: hyper_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Все комбо работают только на BASE (layers = <0>).
        //
        // Скобки — одновременное нажатие соседних клавиш.
        //
        // require-prior-idle-ms: комбо не срабатывает, если меньше 100 мс назад
        // была нажата другая (не-модификатор) клавиша. Защита от ложных
        // срабатываний при наборе: I+O — это английское "-tion", O+P — "op".
        // Нужно «сделать паузу» перед комбо; Shift перед ним не мешает.
        // timeout-ms 40 вместо 50: нажатия с разносом 40–50 мс теперь
        // считаются перекатом двух букв, а не комбо.

        combo_rbrace {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <21 22>;  // O + P
            layers = <0>;
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <20 21>;  // I + O
            layers = <0>;
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <19 20>;  // U + I
            layers = <0>;
            bindings = <&kp MINUS>;    // -
        };

        // Обратный слэш — [ + ' одновременно (правый мизинец, вертикально).
        // В раскладке macOS «Русская» эта клавиша даёт «ё», в «Русская — ПК» — \.
        // На базовом слое отдельной клавиши \ нет.
        combo_bslh {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <23 35>;  // [ + '
            layers = <0>;
            bindings = <&kp BSLH>;    // \  (ё в «Русской»)
        };

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;  // Grave + Backspace одновременно
            layers = <0>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0 BASE — QWERTY, буквы чистые: никаких &lt/&mt на позициях 13–22, 25–34, 37–46
        // (check_keymap.py это проверяет). Слои — только на больших пальцах:
        // 50 NAV/Tab, 54 FUN/Lang, 55 NUM/Enter; 51 — Backspace / Hyper.

        base_layer {
            display-name = "BASE";
            bindings = <
&kp GRAVE      &kp N1  &kp N2  &kp N3     &kp N4    &kp N5              &kp N6                  &kp N7     &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB        &kp Q   &kp W   &kp E      &kp R     &kp T               &kp Y                   &kp U      &kp I      &kp O    &kp P     &kp LBKT
&mt LCTRL ESC  &kp A   &kp S   &kp D      &kp F     &kp G               &kp H                   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&td_shift_l    &kp Z   &kp X   &kp C      &kp V     &kp B               &kp N                   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &td_shift_r
                               &kp SPACE  &kp LGUI  &lt 4 TAB         &hyper_bspc LS(LA(LC(LGUI))) BSPC  &kp SPACE
                                          &kp LALT  &lt 6 LC(SPACE)    &lt 5 RET
            >;
        };

        // 1 MOUSE — авто-слой, поднимается движением шара (&zip_temp_layer в overlay'ях),
        // гаснет через 800 мс или от не-исключённой клавиши.
        // H = ПКМ, J = ЛКМ, N = средняя; удержание K = SNIPE, удержание L = SCROLL.
        // ИНВАРИАНТ: индекс ниже SNIPE/SCROLL/NAV — драйвер смотрит только на верхний слой.
        // K/L обязаны быть в excluded-positions, иначе слой погаснет раньше &mo.

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans     &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans     &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &mo 2  &mo 3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MCLK  &trans     &trans     &trans      &trans  &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        // 2 SNIPE — медленный курсор (snipe-layers драйвера + scaler в overlay).
        // Клики продублированы: пока активен snipe, таймер слоя мыши не продлевается,
        // и после 0.8 с прицеливания H/J/N без этого были бы буквами.

        snipe_layer {
            display-name = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MCLK  &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        // 3 SCROLL — шар крутит колесо. Клики продублированы по той же причине, что в SNIPE.

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MCLK  &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        // 4 NAV (удержание 50), сочетания под Ubuntu: LG(x) = Ctrl+x, LC(x) = Super+x (см. вверху).
        // Правая рука: стрелки на HJKL, Home/PgDn/PgUp/End над ними; ниже — начало файла,
        // слово ←, слово →, конец файла; P/[ — удалить слово влево/вправо; ; — Del.
        // Левая рука: Q — следующее окно той же программы (Super+`), W/E — вкладка
        // назад/вперёд (Ctrl+PgUp/PgDn), A/G — VS Code назад/вперёд по коду,
        // S/D/F — Alt/Ctrl/Shift (шар + F выделяет, шар + D прыгает по словам),
        // Z/X/C — окно влево / развернуть-восстановить / вправо, V/B — на левый/правый монитор.
        // Шар в этом слое двигает текстовый курсор (caret-layers).

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans                 &trans             &trans              &trans                 &trans                    &trans            &trans            &trans             &trans           &trans            &trans
&trans  &kp LC(GRAVE)     &kp LG(PG_UP)  &kp LG(PG_DN)   &trans                 &trans                    &kp HOME          &kp PG_DN         &kp PG_UP          &kp END          &kp LG(BSPC)  &kp LG(DEL)
&trans  &kp LG(LA(MINUS))  &kp LALT           &kp LGUI            &kp LSHFT              &kp LG(LS(MINUS))     &kp LEFT          &kp DOWN          &kp UP             &kp RIGHT        &kp DEL           &trans
&trans  &kp LC(LEFT)      &kp LA(F10)        &kp LC(RIGHT)  &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))    &kp LG(HOME)  &kp LG(LEFT)  &kp LG(RIGHT)  &kp LG(END)  &trans            &trans
                                                  &trans              &trans                 &trans                    &trans            &trans
                                                                      &trans                 &trans                    &trans
            >;
        };

        // 5 NUM (удержание 55) — бывший layer_8 без изменений: numpad слева, моды справа.

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &trans            &trans        &trans        &trans        &trans               &trans  &trans           &trans         &trans         &trans             &trans
&trans  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET    &trans  &trans           &trans         &trans         &trans             &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &trans  &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&trans  &kp TILDE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH            &trans  &trans           &trans         &trans         &trans             &trans
                                        &kp N0        &kp MINUS     &trans               &trans  &trans
                                                      &kp DOT       &trans               &trans
            >;
        };

        // 6 FUN (удержание 54) — F1–F12, Bluetooth, медиа, яркость, Print Screen на [,
        // bootloader (Z — левая половина), studio_unlock.

        fun_layer {
            display-name = "FUN";
            bindings = <
&kp F1  &kp F2          &kp F3        &kp F4        &kp F5        &kp F6          &kp F7        &kp F8        &kp F9      &kp F10       &kp F11       &kp F12
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_PREV    &kp C_PP      &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &kp PSCRN
&trans  &bt BT_CLR_ALL  &trans        &bt BT_CLR    &trans        &bt BT_NXT      &kp C_BRI_DN  &kp C_BRI_UP  &kp K_MUTE  &trans        &trans        &trans
&trans  &bootloader     &trans        &trans        &trans        &trans          &trans        &trans        &trans      &trans        &trans        &studio_unlock
                                      &trans        &trans        &trans          &trans        &trans
                                                    &trans        &trans          &trans
            >;
        };
    };
};
