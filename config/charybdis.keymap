#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>


&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";
        
        // Скобки — одновременное нажатие соседних клавиш
        combo_lbrace {
            timeout-ms = <50>;
            key-positions = <13 14>;  // Q + W (исправлено!)
            bindings = <&kp LBKT>;    // [
        };
        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <14 15>;  // W + E (исправлено!)
            bindings = <&kp RBKT>;    // ]
        };
        combo_lparen {
            timeout-ms = <50>;
            key-positions = <15 16>;  // E + R (исправлено!)
            bindings = <&kp LPAR>;    // (
        };
        combo_rparen {
            timeout-ms = <50>;
            key-positions = <16 17>;  // R + T (исправлено!)
            bindings = <&kp RPAR>;    // )
        };
        combo_lcurly {
            timeout-ms = <50>;
            key-positions = <25 26>;  // A + S (исправлено!)
            bindings = <&kp LBRC>;    // {
        };
        combo_rcurly {
            timeout-ms = <50>;
            key-positions = <26 27>;  // S + D (исправлено!)
            bindings = <&kp RBRC>;    // }
        };
        
        // Переключение языка — J + K одновременно
        combo_lang_switch {
            timeout-ms = <50>;
            key-positions = <31 32>;  // J + K
            bindings = <&kp LC(SPACE)>;  // Ctrl+Space
        };

        // Переключение между окнами одного приложения — TAB + Q
        combo_window_switch {
            timeout-ms = <50>;
            key-positions = <12 13>;  // TAB + Q
            bindings = <&kp LG(GRAVE)>;  // Cmd+`
        };
    };
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp N1  &kp N2   &kp N3            &kp N4        &kp N5          &kp N6      &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W    &kp E             &kp R         &kp T           &kp Y       &kp U      &kp I      &kp O    &kp P     &kp LBKT
&mt LCTRL ESC    &mt LCTRL A  &mt LALT S  &mt LSHFT D  &mt LGUI F  &kp G    &kp H  &mt RGUI J  &mt RSHFT K  &mt LALT L  &mt RCTRL SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &lt 5 X    &lt 3 C    &lt 4 V    &lt 2 B    &kp N   &lt 4 M   &lt 3 COMMA  &lt 5 DOT  &kp FSLH  &kp RIGHT_SHIFT
                                 &kp LEFT_CONTROL  &kp SPACE     &mo 1           &lt 6 DELETE  &kp SPACE
                                                   &kp LEFT_WIN  &kp LEFT_ALT    &kp ENTER
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7     &kp F8     &kp F9    &kp F10  &kp F11    &kp F12
&trans  &none   &none   &none   &none   &trans        &none      &none      &none     &none    &kp MINUS  &kp EQUAL
&trans  &none   &none   &none   &none   &trans        &mkp RCLK  &mkp LCLK  &none     &none    &none      &trans
&trans  &trans  &trans  &trans  &trans  &none         &none      &none      &trans    &trans   &none      &trans
                        &trans  &trans  &trans        &mkp RCLK  &mkp LCLK
                                &trans  &trans        &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp PG_UP  &kp PG_DN  &trans    &trans  &kp PG_DN  &kp PG_UP  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp F3    &kp F4    &kp C_VOL_DN  &kp C_VOL_UP    &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
&trans        &trans        &trans    &trans    &trans        &trans          &trans      &trans      &trans      &trans      &trans        &trans
&trans        &trans        &trans    &trans    &trans        &trans          &mkp RCLK   &mkp LCLK   &trans      &trans      &trans        &trans
&trans        &trans        &trans    &trans    &trans        &trans          &trans      &trans      &trans      &trans      &trans        &trans
                                      &trans    &trans        &trans          &mkp RCLK   &mkp LCLK
                                                              &trans          &trans      &trans
            >;
        };

        symbols_layer {
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
&trans     &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR   &kp PIPE     &kp MINUS  &kp EQUAL &kp UNDER  &kp PLUS  &kp BSLH  &kp GRAVE
&trans     &kp LBRC  &kp RBRC  &kp LT    &kp GT     &kp TILDE    &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT &kp COLON &kp DQT
&trans     &trans    &trans    &trans    &trans     &trans       &trans     &trans    &kp LT     &kp GT    &kp QMARK &trans
                               &trans    &trans     &trans       &trans     &trans
                                         &trans     &trans       &trans
            >;
        };
        hyper_layer {
            bindings = <
&trans  &kp LC(LS(LA(LG(N1))))  &kp LC(LS(LA(LG(N2))))  &kp LC(LS(LA(LG(N3))))  &kp LC(LS(LA(LG(N4))))  &kp LC(LS(LA(LG(N5))))    &kp LC(LS(LA(LG(N6))))  &kp LC(LS(LA(LG(N7))))  &kp LC(LS(LA(LG(N8))))  &kp LC(LS(LA(LG(N9))))  &kp LC(LS(LA(LG(N0))))  &trans
&trans  &kp LC(LS(LA(LG(Q))))   &kp LC(LS(LA(LG(W))))   &kp LC(LS(LA(LG(E))))   &kp LC(LS(LA(LG(R))))   &kp LC(LS(LA(LG(T))))     &kp LC(LS(LA(LG(Y))))   &kp LC(LS(LA(LG(U))))   &kp LC(LS(LA(LG(I))))   &kp LC(LS(LA(LG(O))))   &kp LC(LS(LA(LG(P))))   &trans
&trans  &kp LC(LS(LA(LG(A))))   &kp LC(LS(LA(LG(S))))   &kp LC(LS(LA(LG(D))))   &kp LC(LS(LA(LG(F))))   &kp LC(LS(LA(LG(G))))     &kp LC(LS(LA(LG(H))))   &kp LC(LS(LA(LG(J))))   &kp LC(LS(LA(LG(K))))   &kp LC(LS(LA(LG(L))))   &trans                  &trans
&trans  &kp LC(LS(LA(LG(Z))))   &kp LC(LS(LA(LG(X))))   &kp LC(LS(LA(LG(C))))   &kp LC(LS(LA(LG(V))))   &kp LC(LS(LA(LG(B))))     &kp LC(LS(LA(LG(N))))   &kp LC(LS(LA(LG(M))))   &trans                  &trans                  &trans                  &trans
                                                        &trans                  &trans                  &trans                    &trans                  &trans
                                                                                &trans                  &trans                    &trans
            >;
        };
    };
};
