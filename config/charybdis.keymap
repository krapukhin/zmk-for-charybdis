#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <130>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <80>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <130>;
    require-prior-idle-ms = <80>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Скобки — одновременное нажатие соседних клавиш

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <21 22>;  // O + P
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;  // I + O
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <19 20>;  // U + I
            bindings = <&kp MINUS>;    // -
        };

        combo_backslash {
            timeout-ms = <50>;
            key-positions = <14 15>;  // W + E
            bindings = <&kp BSLH>;    // backslash
        };

        combo_grave {
            timeout-ms = <50>;
            key-positions = <13 14>;  // Q + W
            bindings = <&kp GRAVE>;    // `
        };

        // Переключение языка — J + K одновременно

        combo_lang_switch {
            timeout-ms = <30>;
            key-positions = <31 32>;  // J + K
            bindings = <&kp LA(LS(LG(SPACE)))>;  // Option + Shift + Command + Space
        };

        // Переключение языка с Shift — D + F одновременно (Right Command + Shift + Space)

        combo_lang_switch_shift {
            timeout-ms = <30>;
            key-positions = <27 28>;  // D + F
            bindings = <&kp RG(LS(SPACE))>;  // Right Command + Shift + Space
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp N1       &kp N2      &kp N3              &kp N4          &kp N5                 &kp N6             &kp N7               &kp N8       &kp N9     &kp N0         &kp BACKSPACE
&kp TAB         &kp Q        &kp W       &kp E               &kp R           &kp T                  &kp Y              &kp U                &kp I        &kp O      &kp P          &kp LBKT
&kp CAPSLOCK    &kp A        &kp S       &kp D               &lt 1 F         &kp G                  &kp H              &kp J                &kp K        &kp L      &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &mt LCTRL Z  &mt LALT X  &mt LEFT_GUI C      &lt 2 V         &lt 4 B                &kp N              &mt RIGHT_GUI M      &lt 1 COMMA  &lt 2 DOT  &kp FSLH       &kp RIGHT_SHIFT
                                         &mt LEFT_GUI SPACE  &lt 2 UP_ARROW  &mt RIGHT_ALT RIGHT    &mt RIGHT_ALT DEL  &mt RIGHT_GUI SPACE
                                                             &lt 2 LEFT      &lt 3 DOWN             &kp ENTER
            >;
        };

        snipe-layers {
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp LS(C_AC_HOME)  &kp C_AC_SEARCH  &kp K_MUTE  &kp C_VOL_DN    &kp C_VOL_UP  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp MINUS  &kp EQUAL
&trans        &trans        &trans             &trans           &trans      &trans          &trans        &trans      &trans    &trans      &trans     &kp RIGHT_BRACKET
&trans        &trans        &trans             &trans           &trans      &trans          &mkp RCLK     &mkp LCLK   &trans    &trans      &trans     &kp BACKSLASH
&trans        &trans        &trans             &trans           &trans      &trans          &mkp RCLK     &mkp LCLK   &trans    &trans      &trans     &trans
                                               &trans           &trans      &trans          &mkp RCLK     &mkp LCLK
                                                                &trans      &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans          &trans        &trans     &kp MINUS  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &kp PG_DN       &kp PG_UP     &trans     &trans     &kp RBKT
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN        &kp UP        &kp RIGHT  &trans     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &msc SCRL_DOWN  &msc SCRL_UP  &trans     &trans     &trans
                        &trans  &trans  &trans    &trans    &trans
                                &trans  &trans    &trans
            >;
        };

        F_layers {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7     &kp F8     &kp F9  &kp F10  &kp F11  &kp F12
&trans     &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans   &trans   &trans
&trans     &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans   &trans   &trans
&kp GLOBE  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans   &trans   &trans
                           &trans  &trans  &trans    &trans     &trans
                                   &trans  &trans    &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };
    };
};
