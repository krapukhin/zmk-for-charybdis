#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <130>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <40>;  // Предотвращает случайные срабатывания при быстрой печати
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <130>;
    require-prior-idle-ms = <40>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Скобки — одновременное нажатие соседних клавиш

        combo_rbrace {
            timeout-ms = <50>;
            key-positions = <21 22>;  // O + P
            bindings = <&kp RBKT>;    // ]
        };

        combo_equal {
            timeout-ms = <50>;
            key-positions = <20 21>;  // I + O
            bindings = <&kp EQUAL>;    // =
        };

        combo_minus {
            timeout-ms = <50>;
            key-positions = <19 20>;  // U + I
            bindings = <&kp MINUS>;    // -
        };

        // Переключение языка — J + K одновременно
        // Переключение языка с Shift — D + F одновременно (Right Command + Shift + Space)

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;  // Grave + Backspace одновременно
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp N1   &kp N2   &kp N3     &kp N4        &kp N5          &kp N6                  &kp N7     &kp N8     &kp N9   &kp N0           &kp BACKSPACE
&kp TAB         &kp Q    &kp W    &kp E      &kp R         &kp T           &kp Y                   &kp U      &kp I      &kp O    &kp P            &kp LBKT
&kp CAPSLOCK    &lt 5 A  &lt 3 S  &lt 2 D    &lt 5 F       &kp G           &kp H                   &kp J      &lt 2 K    &lt 3 L  &lt 5 SEMICOLON  &mt RIGHT_ALT SQT
&kp LEFT_SHIFT  &kp Z    &kp X    &kp C      &kp V         &lt 4 B         &kp N                   &kp M      &kp COMMA  &kp DOT  &kp FSLH         &kp RIGHT_SHIFT
                                  &kp SPACE  &mo 6         &kp LEFT_ALT    &mo 8                   &kp SPACE
                                             &kp LEFT_GUI  &mo 7           &mt LEFT_CONTROL ENTER
            >;
        };

        // Layer 1: MOUSE — авто-слой мыши (AML).
        // Поднимается сам при движении трекбола, гаснет по таймауту или по нажатию
        // не-исключённой клавиши. Настройка — &zip_temp_layer в charybdis_right.overlay.
        //
        // ВАЖНО: индекс этого слоя обязан оставаться НИЖЕ snipe(2)/scroll(3)/caret(5).
        // Драйвер трекбола смотрит только на самый верхний активный слой, поэтому
        // AML с большим индексом молча ломает режимы прокрутки/снайпера/каретки.

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp MCLK  &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&kp F1  &kp F2         &kp F3          &kp F4            &kp F5                &kp F6     &kp F7             &kp F8                 &kp F9             &kp F10          &kp F11           &kp F12
&trans  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp TAB    &kp LG(BACKSPACE)  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp RIGHT_BRACKET
&trans  &trans         &trans          &trans            &trans                &trans     &mkp RCLK          &mkp LCLK              &trans             &trans           &trans            &kp BACKSLASH
&trans  &trans         &trans          &trans            &trans                &trans     &mkp MCLK          &trans                 &trans             &trans           &trans            &trans
                                       &trans            &trans                &trans     &mkp RCLK          &mkp LCLK
                                                         &trans                &trans     &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans             &trans    &trans         &trans          &trans     &kp MINUS  &kp EQUAL
&trans  &trans  &trans  &trans  &trans          &trans             &kp HOME  &kp PAGE_UP    &msc SCRL_UP    &trans     &trans     &kp RBKT
&trans  &trans  &trans  &trans  &trans          &trans             &kp LEFT  &kp DOWN       &kp UP          &kp RIGHT  &trans     &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans          &trans             &kp END   &kp PAGE_DOWN  &msc SCRL_DOWN  &trans     &trans     &trans
                        &trans  &kp UP_ARROW    &kp RIGHT_ARROW    &trans    &trans
                                &kp LEFT_ARROW  &kp DOWN_ARROW     &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        // Layer 4: CARET — трекбол двигает текстовый курсор (стрелки) вместо мыши
        // Все клавиши прозрачны, клавиатура работает как обычно

        caret_layer {
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp LS(HOME)  &kp C_AC_SEARCH  &kp K_MUTE  &kp C_VOLUME_DOWN    &kp C_VOLUME_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
&trans                &trans                &trans        &trans           &trans      &trans               &trans           &trans          &trans            &trans      &trans  &trans
                                                          &trans           &trans      &trans               &trans           &trans
                                                                           &trans      &trans               &trans
            >;
        };

        corne_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans          &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans          &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT       &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans          &trans        &trans     &trans  &trans
                        &trans  &trans  &trans    &kp LA(SPACE)  &trans
                                &trans  &trans    &trans
            >;
        };

        corne_2 {
            bindings = <
&trans             &trans  &trans  &trans  &trans  &trans           &trans          &trans          &trans          &trans           &trans           &trans
&kp LA(LC(SPACE))  &trans  &trans  &trans  &trans  &trans           &kp HOME        &mkp LCLK       &msc SCRL_UP    &kp PAGE_UP      &msc SCRL_LEFT   &trans
&trans             &trans  &trans  &trans  &trans  &trans           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans           &trans
&trans             &trans  &trans  &trans  &trans  &trans           &kp END         &mkp RCLK       &msc SCRL_DOWN  &kp PAGE_DOWN    &msc SCRL_RIGHT  &trans
                                   &trans  &trans  &kp LG(SPACE)    &trans          &trans
                                           &trans  &trans           &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans            &trans        &trans        &trans        &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp TILDE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH            &trans  &trans  &trans  &trans  &trans  &trans
                                        &kp N0        &kp MINUS     &trans               &trans  &trans
                                                      &kp DOT       &trans               &trans
            >;
        };
    };
};
