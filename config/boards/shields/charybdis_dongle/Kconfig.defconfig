# Роли донгл-варианта.
#
# Донгл = central, обе половины = peripheral. Половины роль не задают вовсе:
# ZMK_SPLIT_ROLE_CENTRAL по умолчанию n, этого достаточно.
#
# Используется актуальное имя ZMK_SPLIT_ROLE_CENTRAL. Старое
# ZMK_SPLIT_BLE_ROLE_CENTRAL — back-compat алиас (см. app/src/split/bluetooth/Kconfig
# в ZMK), в основном shield'е оставлено как есть, здесь берём новое.

if SHIELD_CHARYBDIS_DONGLE

# ВНИМАНИЕ: не длиннее 15 символов.
# ZMK ставит BT_DEVICE_NAME_MAX=16, чтобы имя влезало в advertising data,
# а Zephyr проверяет строго: BUILD_ASSERT(DEVICE_NAME_LEN < BT_DEVICE_NAME_MAX)
# в subsys/bluetooth/host/hci_core.c. Ровно 16 символов уже не проходит.
config ZMK_KEYBOARD_NAME
	default "Charybdis DGL"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

# Две периферии: левая и правая половины.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

# Число периферий + желаемое число BT-профилей (5).
config BT_MAX_CONN
	default 7

config BT_MAX_PAIRED
	default 7

endif

if SHIELD_CHARYBDIS_LEFT_DONGLE || SHIELD_CHARYBDIS_RIGHT_DONGLE || SHIELD_CHARYBDIS_DONGLE

config ZMK_SPLIT
	default y

endif
