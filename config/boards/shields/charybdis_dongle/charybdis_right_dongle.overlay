#include "charybdis_dongle_common.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio0 2 GPIO_ACTIVE_HIGH>
		, <&gpio0 29 GPIO_ACTIVE_HIGH>
		, <&gpio0 9 GPIO_ACTIVE_HIGH>
		, <&gpio1 0  GPIO_ACTIVE_HIGH>
		, <&gpio0 11 GPIO_ACTIVE_HIGH>
		, <&gpio1 4  GPIO_ACTIVE_HIGH>
		;
};

// trackball
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-zmk";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /*
         * *-layers здесь НАМЕРЕННО не заданы, в отличие от основного варианта.
         * Драйвер выбирает режим через zmk_keymap_highest_layer_active(), но на
         * периферии раскладки нет: keymap.c собирается только для central
         * (app/CMakeLists.txt в ZMK). Драйвер это учитывает — на периферии он
         * всегда работает в режиме MOVE.
         *
         * snipe, scroll и auto mouse layer реализованы на донгле через
         * input-processors, см. charybdis_dongle.overlay.
         * Caret-режима в донгл-варианте нет — воспроизвести его нечем.
         */
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};



&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
    };

    /*
     * Проброс трекбола на донгл. Сам сенсор остаётся здесь, а вся обработка
     * (auto mouse layer, snipe, scroll) живёт на донгле — периферия не знает
     * активного слоя, ZMK состояние слоёв на неё не передаёт.
     *
     * reg должен совпадать с приёмником в charybdis_dongle.overlay.
     */
    /*
     * Проброс трекбола на донгл. Сенсор остаётся здесь, вся обработка
     * (auto mouse layer, snipe, scroll) живёт на донгле: периферия не знает
     * активного слоя — ZMK состояние слоёв на неё не передаёт.
     *
     * reg должен совпадать с приёмником в charybdis_dongle.overlay.
     */
    trackball_split: trackball_split@0 {
        compatible = "zmk,input-split";
        reg = <0>;
        device = <&trackball>;
    };
};
