/*
 * ДОНГЛ (Seeed XIAO nRF52840). Роль central, физических клавиш нет.
 *
 * Матрица и физическая раскладка — копия charybdis.dtsi, но:
 *   - у layout-узла убрано свойство kscan (требование документации ZMK)
 *   - нет chosen zmk,underglow: на донгле нет led_strip
 *   - kscan заменён на mock, чтобы не занимать GPIO
 *
 * При правке матрицы в основном варианте синхронизировать и здесь.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &charybdis_physical_layout;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    charybdis_physical_layout: charybdis_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis 4x6";
        transform = <&default_transform>;
        keys =
            // Row 0: left (6 keys) + right (6 keys)
            <&key_physical_attrs 100 100   0   0 0 0 0>  // L0: Grave
          , <&key_physical_attrs 100 100 100   0 0 0 0>  // L1: N1
          , <&key_physical_attrs 100 100 200   0 0 0 0>  // L2: N2
          , <&key_physical_attrs 100 100 300   0 0 0 0>  // L3: N3
          , <&key_physical_attrs 100 100 400   0 0 0 0>  // L4: N4
          , <&key_physical_attrs 100 100 500   0 0 0 0>  // L5: N5
          , <&key_physical_attrs 100 100 900   0 0 0 0>  // R0: N6
          , <&key_physical_attrs 100 100 1000  0 0 0 0>  // R1: N7
          , <&key_physical_attrs 100 100 1100  0 0 0 0>  // R2: N8
          , <&key_physical_attrs 100 100 1200  0 0 0 0>  // R3: N9
          , <&key_physical_attrs 100 100 1300  0 0 0 0>  // R4: N0
          , <&key_physical_attrs 100 100 1400  0 0 0 0>  // R5: Backspace
            // Row 1: left (6 keys) + right (6 keys)
          , <&key_physical_attrs 100 100   0 100 0 0 0>  // L0: Tab
          , <&key_physical_attrs 100 100 100 100 0 0 0>  // L1: Q
          , <&key_physical_attrs 100 100 200 100 0 0 0>  // L2: W
          , <&key_physical_attrs 100 100 300 100 0 0 0>  // L3: E
          , <&key_physical_attrs 100 100 400 100 0 0 0>  // L4: R
          , <&key_physical_attrs 100 100 500 100 0 0 0>  // L5: T
          , <&key_physical_attrs 100 100 900 100 0 0 0>  // R0: Y
          , <&key_physical_attrs 100 100 1000 100 0 0 0> // R1: U
          , <&key_physical_attrs 100 100 1100 100 0 0 0> // R2: I
          , <&key_physical_attrs 100 100 1200 100 0 0 0> // R3: O
          , <&key_physical_attrs 100 100 1300 100 0 0 0> // R4: P
          , <&key_physical_attrs 100 100 1400 100 0 0 0> // R5: LBKT
            // Row 2: left (6 keys) + right (6 keys)
          , <&key_physical_attrs 100 100   0 200 0 0 0>  // L0: Caps
          , <&key_physical_attrs 100 100 100 200 0 0 0>  // L1: A
          , <&key_physical_attrs 100 100 200 200 0 0 0>  // L2: S
          , <&key_physical_attrs 100 100 300 200 0 0 0>  // L3: D
          , <&key_physical_attrs 100 100 400 200 0 0 0>  // L4: F
          , <&key_physical_attrs 100 100 500 200 0 0 0>  // L5: G
          , <&key_physical_attrs 100 100 900 200 0 0 0>  // R0: H
          , <&key_physical_attrs 100 100 1000 200 0 0 0> // R1: J
          , <&key_physical_attrs 100 100 1100 200 0 0 0> // R2: K
          , <&key_physical_attrs 100 100 1200 200 0 0 0> // R3: L
          , <&key_physical_attrs 100 100 1300 200 0 0 0> // R4: ;
          , <&key_physical_attrs 100 100 1400 200 0 0 0> // R5: '
            // Row 3: left (6 keys) + right (6 keys)
          , <&key_physical_attrs 100 100   0 300 0 0 0>  // L0: LShift
          , <&key_physical_attrs 100 100 100 300 0 0 0>  // L1: Z
          , <&key_physical_attrs 100 100 200 300 0 0 0>  // L2: X
          , <&key_physical_attrs 100 100 300 300 0 0 0>  // L3: C
          , <&key_physical_attrs 100 100 400 300 0 0 0>  // L4: V
          , <&key_physical_attrs 100 100 500 300 0 0 0>  // L5: B
          , <&key_physical_attrs 100 100 900 300 0 0 0>  // R0: N
          , <&key_physical_attrs 100 100 1000 300 0 0 0> // R1: M
          , <&key_physical_attrs 100 100 1100 300 0 0 0> // R2: ,
          , <&key_physical_attrs 100 100 1200 300 0 0 0> // R3: .
          , <&key_physical_attrs 100 100 1300 300 0 0 0> // R4: /
          , <&key_physical_attrs 100 100 1400 300 0 0 0> // R5: RShift
            // Подписи ниже — привязки слоя QWERTY из charybdis.keymap (для ориентации при чтении).
            // Thumbs left: 3 keys (row 4: RC(4,3) RC(4,2) RC(4,1))
          , <&key_physical_attrs 100 100 300 425 0 0 0>  // LT0: GUI
          , <&key_physical_attrs 100 100 400 425 0 0 0>  // LT1: Space
          , <&key_physical_attrs 100 100 500 425 0 0 0>  // LT2: MO(6) — corne_1 (стрелки на HJKL)
            // Thumbs right: 2 keys (row 4: RC(4,7) RC(4,8))
          , <&key_physical_attrs 100 100 900 425 0 0 0>  // RT0: MO(7) — corne_2 (мышь на HJKL)
          , <&key_physical_attrs 100 100 1000 425 0 0 0> // RT1: Space
            // Thumbs left bottom: 2 keys (RC(4,5) RC(4,4))
          , <&key_physical_attrs 100 100 400 525 0 0 0>  // LT3: Ctrl
          , <&key_physical_attrs 100 100 500 525 0 0 0>  // LT4: Alt
            // Thumb right bottom: 1 key (RC(4,10))
          , <&key_physical_attrs 100 100 1000 525 0 0 0> // RT2: Enter
          ;
    };

    default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
			RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)                   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
			RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)                   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
			RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
			RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)                   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
					                RC(4,3) RC(4,2) RC(4,1)                   RC(4,7)  RC(4,8)
									        RC(4,5) RC(4,4)                   RC(4,10) 
        >;
    };
	

    /*
     * Приёмник трекбола с правой половины. reg должен совпадать с
     * trackball_split в charybdis_right_dongle.overlay.
     */
    trackball_split: trackball_split@0 {
        compatible = "zmk,input-split";
        reg = <0>;
    };

    /*
     * Вся обработка указателя живёт здесь, а не в драйвере: на периферии нет
     * раскладки, поэтому режимы трекбола решаются только на central.
     *
     * Ускорение при этом остаётся в драйвере на периферии — оно чисто
     * арифметическое и от раскладки не зависит.
     *
     * Номера слоёв должны совпадать с config/charybdis.keymap:
     *   1 = mouse_layer, 2 = snipe, 3 = scroll
     */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;

        // Auto mouse layer — как в основном варианте.
        input-processors = <&zip_temp_layer 1 800>;

        // Snipe: программное деление вместо аппаратной смены CPI сенсора
        // (с донгла CPI не поменять). Подбирать заново — это не то же самое,
        // что SNIPE_CPI=200 в прямом режиме.
        snipe_scaler {
            layers = <2>;
            input-processors = <&zip_xy_scaler 1 4>;
        };

        // Scroll: штатный маппер X/Y -> колесо. Механика отличается от
        // аккумулятора SCROLL_TICK в драйвере, скорость подбирать заново.
        scroll_mapper {
            layers = <3>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };
};

// Настройки авто-слоя мыши — идентичны основному варианту.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <30 31 32 36 47 48 53 54>;
};
